{
  "name": "civora-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean:next": "node scripts/clean-next-artifacts.mjs",
    "dev": "next dev --webpack",
    "dev:test": "npm run clean:next && next dev --webpack",
    "prebuild": "npm run clean:next",
    "build": "node scripts/build-next-stable.mjs",
    "start": "next start",
    "serve:test": "npm run build && next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint",
    "release:regression": "../../scripts/release_regression.sh",
    "test:live": "npm run clean:next && playwright test --config=playwright.config.ts",
    "test:hosted:public": "PLAYWRIGHT_SKIP_WEBSERVER=1 PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-https://civoraai.com} playwright test --config=playwright.config.ts tests/live/hosted-public-workspace-smoke.spec.ts --project=chromium --workers=1",
    "test:hosted:auth": "playwright test --config=playwright.config.ts tests/live/hosted-auth-smoke.spec.ts --project=chromium --workers=1",
    "test:live:chat34": "node tests/live/chat34-controlled-pilot-readiness.js",
    "test:live:staged": "playwright test --config=playwright.config.ts tests/live/staged-regression.spec.ts",
    "test:live:headed": "playwright test --config=playwright.config.ts --headed"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.6.0",
    "mapbox-gl": "^3.22.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
