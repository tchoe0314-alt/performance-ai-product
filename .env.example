# AI language provider:
# - none: no external LLM; Civora uses deterministic/local backend fallbacks.
# - openai: use OpenAI through OPENAI_API_KEY.
# - ollama/local: use a local Ollama server.
CIVORA_AI_PROVIDER=none
OPENAI_API_KEY=
CIVORA_OLLAMA_BASE_URL=http://localhost:11434
CIVORA_CHAT_MODEL=gpt-5
CIVORA_COMMAND_MODEL=gpt-5
CIVORA_CAD_ASSISTANT_MODEL=gpt-5
CIVORA_PRODUCT_MODE=private_alpha
CIVORA_DEPLOYMENT_TARGET=local
CIVORA_FRONTEND_PUBLIC_URL=http://localhost:3000
CIVORA_PUBLIC_API_BASE_URL=http://127.0.0.1:8002
CIVORA_SESSION_SECRET=
CIVORA_CRON_SECRET=
PERFORMANCE_AI_STORAGE_DIR=./data
DATABASE_URL=
CIVORA_DATABASE_CONNECT_TIMEOUT_SECONDS=10
CIVORA_DATABASE_POOL_MIN_SIZE=1
CIVORA_DATABASE_POOL_MAX_SIZE=4
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CIVORA_ALLOW_LOCAL_PILOT_CORS=false
CIVORA_LOCAL_PILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8002
MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=
CIVORA_OCR_ENGINE=
CIVORA_OCR_LANG=eng
CIVORA_PDF_RENDERER=
CIVORA_GIS_PROVIDER_REGISTRY_URL=
CIVORA_REQUIRE_GIS_PROVIDERS=false
# Worldwide best-effort mapped context and point elevation. For sustained hosted
# traffic, configure provider capacity/terms appropriate to your deployment.
CIVORA_OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
CIVORA_GLOBAL_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
CIVORA_IMAGERY_DETECTION_PROVIDER=
CIVORA_IMAGERY_DETECTION_URL=
CIVORA_IMAGERY_DETECTION_TOKEN=
CIVORA_PROCESS_ROLE=combined
CIVORA_DEDICATED_WORKER_ENABLED=false
CIVORA_ENABLED_JOB_TYPES=
CIVORA_DISABLED_JOB_TYPES=
PERFORMANCE_AI_JOB_WORKERS=1
PERFORMANCE_AI_RESUME_PENDING_JOBS=true
PERFORMANCE_AI_RESUME_POLL_SECONDS=1
# Learned inference is fail-closed. Use civora_heuristic only as an explicitly
# labeled development fallback; use civora_hybrid only with fallback enabled.
CIVORA_GATEWAY_DETECTOR_KIND=civora_model
CIVORA_GATEWAY_SOURCE_MODE=mapbox_static
CIVORA_GATEWAY_MAPBOX_TOKEN=
CIVORA_GATEWAY_MAPBOX_STYLE=mapbox/satellite-v9
CIVORA_GATEWAY_IMAGE_SIZE=1024x1024
CIVORA_GATEWAY_CIVORA_MAX_SIZE=768
CIVORA_GATEWAY_MODEL_NAME=
CIVORA_GATEWAY_MODEL_VERSION=
CIVORA_GATEWAY_MODEL_MANIFEST=
CIVORA_GATEWAY_MODEL_PATH=
CIVORA_GATEWAY_REQUIRE_PROMOTED_MODEL=true
CIVORA_GATEWAY_ALLOW_HEURISTIC_FALLBACK=false
CIVORA_GATEWAY_BEARER_TOKEN=
CIVORA_GATEWAY_IMAGE_HOST_ALLOWLIST=api.mapbox.com
CIVORA_GATEWAY_MAX_IMAGE_BYTES=15728640
CIVORA_GATEWAY_ALLOW_PRIVATE_IMAGE_URLS=false
CIVORA_GATEWAY_ALLOW_INSECURE_IMAGE_URLS=false
CIVORA_GATEWAY_ALLOW_UNKNOWN_IMAGE_CONTENT_TYPE=false
# Keep source reuse/training disabled unless counsel or the source license has
# explicitly cleared the deployed imagery source for those uses.
CIVORA_GATEWAY_SOURCE_LICENSE=unconfirmed
CIVORA_GATEWAY_SOURCE_ATTRIBUTION=
CIVORA_GATEWAY_SOURCE_RIGHTS_URL=
CIVORA_GATEWAY_TRAINING_USE_ALLOWED=false
CIVORA_GATEWAY_SOURCE_STORAGE_ALLOWED=false
# Only enable behind a trusted/authenticated caller. Public request payloads
# must not be able to self-authorize imagery training rights.
CIVORA_GATEWAY_TRUST_REQUEST_SOURCE_RIGHTS=false
CIVORA_GATEWAY_GENERIC_DETECTOR_URL=
CIVORA_GATEWAY_GENERIC_DETECTOR_TOKEN=
ROBOFLOW_API_URL=
ROBOFLOW_API_KEY=
ROBOFLOW_IMAGE_MODE=url_param
CIVORA_JOB_TIMEOUT_SECONDS=900
CIVORA_MEMORY_WARN_MB=512
CIVORA_RUNTIME_DEBUG_BEARER_TOKEN=
CIVORA_MAX_IMAGE_UPLOAD_BYTES=10485760
CIVORA_MAX_SURVEY_UPLOAD_BYTES=5242880
CIVORA_MAX_EXISTING_CONDITIONS_UPLOAD_BYTES=26214400
CIVORA_SUPPORT_CONTACT_URL=
CIVORA_SUPPORT_EMAIL=support@civora.ai
CIVORA_BUG_REPORT_URL=
CIVORA_ESCALATION_CONTACT=
CIVORA_MONITORING_OWNER=
CIVORA_ROLLBACK_OWNER=
CIVORA_PUBLIC_BETA_RELEASE_GATES_GREEN=false
CIVORA_ALPHA_REVIEW_ONLY=true
CIVORA_ENABLE_PUBLIC_ACCESS=false

# Paid pilot / billing foundation:
# Defaults keep paid pilot mode and payment collection off.
CIVORA_PAID_PILOT_MODE=false
CIVORA_ENABLE_REAL_CHARGING=false
CIVORA_BILLING_LEGAL_DOCS_READY=false
CIVORA_BILLING_PROVIDER=none
CIVORA_PILOT_PLAN_CODE=pilot_manual
CIVORA_PILOT_PLAN_LABEL=Paid pilot manual billing
CIVORA_PILOT_MONTHLY_PROJECT_LIMIT=5
CIVORA_PILOT_MONTHLY_EXPORT_LIMIT=20
CIVORA_PILOT_MONTHLY_JOB_LIMIT=40
CIVORA_PAID_PILOT_USER_IDS=
CIVORA_PAID_PILOT_EMAILS=
CIVORA_TERMS_URL=
CIVORA_PRIVACY_URL=
CIVORA_ORDER_FORM_URL=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PILOT_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
