FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONPATH=/app
ENV HF_HOME=/models/huggingface
ENV CIVORA_RENDERER_ENGINE=diffusers
ENV CIVORA_RENDERER_EAGER_LOAD=true
ENV CIVORA_RENDERER_USE_DEPTH_CONTROL=true

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_ai_renderer.txt ./
RUN python3 -m pip install --break-system-packages \
      --index-url https://download.pytorch.org/whl/cu128 \
      torch==2.11.0 torchvision==0.26.0 \
    && python3 -m pip install --break-system-packages -r requirements_ai_renderer.txt

COPY backend ./backend

RUN mkdir -p /models/huggingface

EXPOSE 8091

HEALTHCHECK --interval=30s --timeout=10s --start-period=600s --retries=5 \
  CMD curl --fail http://127.0.0.1:${PORT:-8091}/health || exit 1

CMD ["sh", "-c", "python3 -m uvicorn backend.scripts.ai_renderer_gateway:app --host 0.0.0.0 --port ${PORT:-8091} --workers 1"]
