FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libexpat1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_backend.txt .
RUN pip install -r requirements_backend.txt

COPY backend ./backend
COPY vision ./vision

ENV PYTHONPATH=/app
ENV CIVORA_GATEWAY_DETECTOR_KIND=civora
ENV CIVORA_GATEWAY_MAPBOX_STYLE=mapbox/satellite-v9
ENV CIVORA_GATEWAY_IMAGE_SIZE=1024x1024
ENV CIVORA_GATEWAY_CIVORA_MAX_SIZE=768

EXPOSE 8090

CMD ["sh", "-c", "uvicorn backend.scripts.imagery_detection_gateway:app --host 0.0.0.0 --port ${PORT:-8090}"]
